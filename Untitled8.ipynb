      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "\n",
        "# 1. Separate features (X) and target variable (y)\n",
        "X = df_scaled[numerical_cols] # Features are the scaled numerical air quality metrics\n",
        "y = df_scaled['pollution_category'] # Target variable is the pollution category\n",
        "\n",
        "# 2. Encode the categorical target variable\n",
        "label_encoder = LabelEncoder()\n",
        "y_encoded = label_encoder.fit_transform(y)\n",
        "\n",
        "print(\"Original pollution categories:\", y.unique())\n",
        "print(\"Encoded pollution labels:\", label_encoder.classes_)\n",
        "print(\"First 5 encoded target values:\", y_encoded[:5])\n",
        "\n",
        "# 3. Split data into training and testing sets\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y_encoded, test_size=0.2, random_state=42)\n",
        "\n",
        "print(f\"\\nShape of X_train: {X_train.shape}\")\n",
        "print(f\"Shape of X_test: {X_test.shape}\")\n",
        "print(f\"Shape of y_train: {y_train.shape}\")\n",
        "print(f\"Shape of y_test: {y_test.shape}\")"
