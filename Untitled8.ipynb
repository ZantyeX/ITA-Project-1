      "source": [
        "from sklearn.cluster import DBSCAN\n",
        "from sklearn.decomposition import PCA\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "print(\"Imported DBSCAN, PCA, matplotlib.pyplot, and seaborn.\")"
